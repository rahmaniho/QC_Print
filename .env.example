# Copy to .env.local for local development. Never commit actual secrets.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DB_POOL_MAX="2"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="QC Print Inspector"

# Required once, only when creating the first administrator with pnpm db:seed.
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="مدیر سیستم"
ADMIN_PASSWORD=""

# Optional services: uploads and password-reset email.
BLOB_READ_WRITE_TOKEN=""
RESEND_API_KEY=""
EMAIL_FROM="QC Print <quality@example.com>"
